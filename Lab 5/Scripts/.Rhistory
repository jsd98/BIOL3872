group_by(accepted_name, year) %>%
summarize(
mean_cpue = mean(num_cpue, na.rm = TRUE),
.groups = "drop"
)
# Data frame 2: Average depth per species
depth_by_species <- fish_abundance %>%
group_by(accepted_name) %>%
summarize(
mean_depth = mean(depth, na.rm = TRUE),
.groups = "drop"
)
